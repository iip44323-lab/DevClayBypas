local SecurityUtils = require("GameLua.Mod.BaseMod.Common.Security.SecurityCommonUtils")

_G.CLAY_WH = _G.CLAY_WH or {
    enabled = true,
    check_cover = true,
    glow = 3.0,
    red = {R=255, G=0, B=0, A=1},
    green = {R=0, G=255, B=0, A=1},
    max_check_distance = 50000,
    update_interval = 0.55,
    trace_interval = 1.10,
}

local ColorNames = {
    "Color", "BaseColor", "BodyColor", "MainColor", "Tint",
    "Para_Color", "Para_ColorTint", "Para_Color_1",
    "DiffuseColor", "EmissiveColor", "GlowColor", "TintColor",
    "SelectionColor", "Extra Light Color",
    "Base Color", "CharacterColor", "PlayerColor", "SkinColor",
    "EmissiveColor_1", "OverlayColor"
}

local function V(o) return slua.isValid(o) end

local function A(p)
    if not V(p) then return false end
    if p.HealthStatus then return SecurityUtils.IsHealthStatusAlive(p.HealthStatus) end
    if p.IsAlive then return p:IsAlive() end
    if p.GetHealth then return (p:GetHealth() or 0) > 0 end
    return false
end

local function E(p)
    local pl = GameplayData.GetPlayerCharacter()
    if not V(pl) or not V(p) then return false end
    if p == pl then return false end
    return (p.TeamID or 0) ~= (pl.TeamID or 0)
end

local function GM(a)
    local m = {}
    pcall(function()
        if V(a.Mesh) then table.insert(m, a.Mesh) end
        local S = import("SkeletalMeshComponent")
        if S then
            local c = a:GetComponentsByClass(S)
            if c then
                local n = (type(c.Num) == "function") and c:Num() or #c
                for i = 1, math.min(n, 10) do
                    local co = (type(c.Get) == "function") and c:Get(i-1) or c[i]
                    if V(co) and co ~= a.Mesh then table.insert(m, co) end
                end
            end
        end
    end)
    return m
end

local CoverCache = {}
local ColorState = {}
local WHActive = {}

local function CheckCover_LineTrace(target, localPlayer)
    if not V(target) or not V(localPlayer) then return false end
    local isBlocked = false
    pcall(function()
        local world = localPlayer:GetWorld()
        if not V(world) then return end
        local startPos = localPlayer:K2_GetActorLocation()
        local myHead = nil
        pcall(function()
            if V(localPlayer.Mesh) then
                myHead = localPlayer.Mesh:GetSocketLocation("head")
            end
        end)
        if myHead then startPos = myHead end
        local endPos = target:K2_GetActorLocation()
        local targetHead = nil
        pcall(function()
            if V(target.Mesh) then
                targetHead = target.Mesh:GetSocketLocation("head")
            end
        end)
        if targetHead then endPos = targetHead end
        local hitResult = FHitResult()
        local traceParams = FTraceParams or {}
        local trace = nil
        pcall(function()
            if world.LineTraceSingleByChannel then
                trace = world:LineTraceSingleByChannel(hitResult, startPos, endPos, ECC_Visibility or 0, traceParams, true)
            elseif world.LineTraceSingle then
                trace = world:LineTraceSingle(hitResult, startPos, endPos, true, {}, true)
            end
        end)
        if trace and hitResult and hitResult.Actor then
            local hitActor = hitResult.Actor
            if V(hitActor) and hitActor ~= target and hitActor ~= localPlayer then
                local isValidBlocker = false
                pcall(function()
                    local class = hitActor:GetClass()
                    if V(class) then
                        local className = class:GetName() or ""
                        if not string.find(className, "Projectile") and
                           not string.find(className, "Effect") and
                           not string.find(className, "Particle") and
                           not string.find(className, "AI_") and
                           not string.find(className, "Fake") and
                           not string.find(className, "Decal") then
                            isValidBlocker = true
                        end
                    end
                end)
                if isValidBlocker then isBlocked = true end
            end
        end
    end)
    return isBlocked
end

local function CheckCover_Pose(target)
    if not V(target) then return false end
    local isCover = false
    pcall(function()
        if target.bIsCrouched or target.bIsProne then isCover = true end
    end)
    return isCover
end

local function IsBehindCover(target, localPlayer)
    if not V(target) or not V(localPlayer) then return false end
    local cache = CoverCache[target]
    local now = os.clock()
    if cache and (now - cache.time) < _G.CLAY_WH.trace_interval then
        return cache.isCover
    end
    local dist = 0
    pcall(function()
        local loc1 = target:K2_GetActorLocation()
        local loc2 = localPlayer:K2_GetActorLocation()
        dist = FVector.Dist(loc1, loc2)
    end)
    local isCover = false
    if dist < _G.CLAY_WH.max_check_distance then
        isCover = CheckCover_LineTrace(target, localPlayer)
    end
    if not isCover then
        isCover = CheckCover_Pose(target)
    end
    CoverCache[target] = {isCover = isCover, time = now}
    return isCover
end

local function ApplyWallhackColor(o, c, g)
    if not V(o) then return end
    local ms = GM(o)
    for _, me in ipairs(ms) do
        for i = 0, 5 do
            pcall(function()
                local mt = me:GetMaterial(i)
                if V(mt) then
                    local bm = mt:GetBaseMaterial()
                    if V(bm) then
                        bm.bDisableDepthTest = true
                        bm.BlendMode = 2
                    end
                end
            end)
        end
        for i = 0, 5 do
            pcall(function()
                local mi = me:CreateAndSetMaterialInstanceDynamic(i)
                if V(mi) then
                    for _, n in ipairs(ColorNames) do
                        mi:SetVectorParameterValue(n, c)
                    end
                    mi:SetScalarParameterValue("Emissive", g or 3.0)
                    mi:SetScalarParameterValue("EmissiveStrength", g or 3.0)
                    mi:SetScalarParameterValue("GlowIntensity", g or 3.0)
                end
            end)
        end
        pcall(function() me:SetDistanceCullEnabled(false) end)
        pcall(function() me:SetRenderInMainPass(true) end)
        pcall(function() me:SetRenderInDepthPass(false) end)
        pcall(function() me.bAllowCullDistanceVolume = false end)
        pcall(function() me.bUseAsOccluder = false end)
    end
    o._wh = true
    WHActive[o] = true
end

local function RemoveWallhackColor(p)
    if not V(p) then return end
    local ms = GM(p)
    for _, me in ipairs(ms) do
        for i = 0, 5 do
            pcall(function()
                local mt = me:GetMaterial(i)
                if V(mt) then
                    local bm = mt:GetBaseMaterial()
                    if V(bm) then
                        bm.bDisableDepthTest = false
                        bm.BlendMode = 1
                    end
                end
            end)
        end
        pcall(function() me:SetRenderInDepthPass(true) end)
    end
    p._wh = nil
    WHActive[p] = nil
    ColorState[p] = nil
    CoverCache[p] = nil
end

local function RunWallhack()
    if not _G.CLAY_WH.enabled then
        for p, _ in pairs(WHActive) do
            RemoveWallhackColor(p)
        end
        return
    end
    local localPlayer = GameplayData.GetPlayerCharacter()
    if not V(localPlayer) then return end
    local allPawns = Game:GetAllPlayerPawns() or {}
    local scanned = {}
    local redColor = _G.CLAY_WH.red
    local greenColor = _G.CLAY_WH.green
    local glow = _G.CLAY_WH.glow
    local checkCover = _G.CLAY_WH.check_cover
    for _, p in pairs(allPawns) do
        if E(p) and A(p) then
            scanned[p] = true
            local color = redColor
            local state = "red"
            if checkCover then
                if IsBehindCover(p, localPlayer) then
                    color = greenColor
                    state = "green"
                end
            end
            if ColorState[p] ~= state then
                ApplyWallhackColor(p, color, glow)
                ColorState[p] = state
            end
        end
    end
    for p, _ in pairs(WHActive) do
        if not scanned[p] then
            RemoveWallhackColor(p)
        end
    end
    local now = os.clock()
    for pawn, data in pairs(CoverCache) do
        if not V(pawn) or (now - data.time) > 3.0 then
            CoverCache[pawn] = nil
        end
    end
end

